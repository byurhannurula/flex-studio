{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flex-studio",
  "compatibility_date": "2026-10-22",
  // Static site only: no Worker script, Cloudflare serves the files in public/.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // The zone byurhannurula.com must be in the same Cloudflare account.
  "routes": [{ "pattern": "flexstudio.byurhannurula.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
